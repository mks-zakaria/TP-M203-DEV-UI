<resources>
    <!-- Thème de l'application (manifeste : <application android:theme>) -->
    <style name="tp29_Base.Theme.TPS29" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp29_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp29_white</item>
        <item name="colorSecondary">@color/tp29_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp29_vert_clair</item>
        <item name="actionBarStyle">@style/tp29_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp29_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp29_BoutonAlAmal</item>
    </style>

    <style name="tp29_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp29_bleu_nuit</item>
    </style>

    <style name="tp29_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp29_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp29_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp29_TitreBarre</item>
    </style>

    <style name="tp29_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp29_white</item>
    </style>

    <style name="tp29_Theme.TPS29" parent="tp29_Base.Theme.TPS29" />
</resources>
