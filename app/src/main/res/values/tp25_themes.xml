<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp25_Base.Theme.TPS25" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp25_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp25_white</item>
        <item name="colorSecondary">@color/tp25_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp25_vert_clair</item>
        <item name="actionBarStyle">@style/tp25_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp25_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp25_BoutonAlAmal</item>
    </style>

    <style name="tp25_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp25_bleu_nuit</item>
    </style>

    <style name="tp25_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp25_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp25_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp25_TitreBarre</item>
    </style>

    <style name="tp25_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp25_white</item>
    </style>

    <style name="tp25_Theme.TPS25" parent="tp25_Base.Theme.TPS25" />
</resources>
