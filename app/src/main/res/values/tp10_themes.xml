<resources>
    <!-- Thème clair avec barre d'action verte (titre de l'application en haut) -->
    <style name="tp10_Base.Theme.TPS10" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp10_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp10_white</item>
        <item name="colorSecondary">@color/tp10_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp10_vert_clair</item>
        <item name="actionBarStyle">@style/tp10_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textViewStyle">@style/tp10_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp10_BoutonAlAmal</item>
    </style>

    <style name="tp10_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp10_bleu_nuit</item>
    </style>

    <style name="tp10_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp10_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp10_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp10_TitreBarre</item>
    </style>

    <style name="tp10_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp10_white</item>
    </style>

    <style name="tp10_Theme.TPS10" parent="tp10_Base.Theme.TPS10" />
</resources>
