<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp20_Base.Theme.TPS20" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp20_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp20_white</item>
        <item name="colorSecondary">@color/tp20_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp20_vert_clair</item>
        <item name="actionBarStyle">@style/tp20_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp20_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp20_BoutonAlAmal</item>
    </style>

    <style name="tp20_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp20_bleu_nuit</item>
    </style>

    <style name="tp20_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp20_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp20_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp20_TitreBarre</item>
    </style>

    <style name="tp20_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp20_white</item>
    </style>

    <style name="tp20_Theme.TPS20" parent="tp20_Base.Theme.TPS20" />
</resources>
