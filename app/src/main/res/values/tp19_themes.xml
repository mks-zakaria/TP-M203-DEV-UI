<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp19_Base.Theme.TPS19" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp19_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp19_white</item>
        <item name="colorSecondary">@color/tp19_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp19_vert_clair</item>
        <item name="actionBarStyle">@style/tp19_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp19_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp19_BoutonAlAmal</item>
    </style>

    <style name="tp19_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp19_bleu_nuit</item>
    </style>

    <style name="tp19_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp19_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp19_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp19_TitreBarre</item>
    </style>

    <style name="tp19_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp19_white</item>
    </style>

    <style name="tp19_Theme.TPS19" parent="tp19_Base.Theme.TPS19" />

    <!-- Variante sans barre d'action (écrans avec Toolbar) -->
    <style name="tp19_Theme.TPS19.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
