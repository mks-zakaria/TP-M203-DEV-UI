<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp21_Base.Theme.TPS21" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp21_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp21_white</item>
        <item name="colorSecondary">@color/tp21_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp21_vert_clair</item>
        <item name="actionBarStyle">@style/tp21_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp21_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp21_BoutonAlAmal</item>
    </style>

    <style name="tp21_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp21_bleu_nuit</item>
    </style>

    <style name="tp21_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp21_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp21_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp21_TitreBarre</item>
    </style>

    <style name="tp21_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp21_white</item>
    </style>

    <style name="tp21_Theme.TPS21" parent="tp21_Base.Theme.TPS21" />
</resources>
