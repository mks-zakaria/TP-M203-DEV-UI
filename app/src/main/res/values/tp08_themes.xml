<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp08_Base.Theme.TPS08" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp08_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp08_white</item>
        <item name="colorSecondary">@color/tp08_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp08_vert_clair</item>
        <item name="actionBarStyle">@style/tp08_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp08_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp08_BoutonAlAmal</item>
    </style>

    <style name="tp08_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp08_bleu_nuit</item>
    </style>

    <style name="tp08_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp08_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp08_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp08_TitreBarre</item>
    </style>

    <style name="tp08_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp08_white</item>
    </style>

    <style name="tp08_Theme.TPS08" parent="tp08_Base.Theme.TPS08" />
</resources>
