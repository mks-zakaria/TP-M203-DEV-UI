<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp17_Base.Theme.TPS17" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp17_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp17_white</item>
        <item name="colorSecondary">@color/tp17_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp17_vert_clair</item>
        <item name="actionBarStyle">@style/tp17_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp17_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp17_BoutonAlAmal</item>
    </style>

    <style name="tp17_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp17_bleu_nuit</item>
    </style>

    <style name="tp17_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp17_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp17_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp17_TitreBarre</item>
    </style>

    <style name="tp17_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp17_white</item>
    </style>

    <style name="tp17_Theme.TPS17" parent="tp17_Base.Theme.TPS17" />

    <!-- Variante sans barre d'action (écrans avec Toolbar) -->
    <style name="tp17_Theme.TPS17.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
