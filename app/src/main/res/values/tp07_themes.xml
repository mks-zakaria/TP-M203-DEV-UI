<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp07_Base.Theme.TPS07" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp07_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp07_white</item>
        <item name="colorSecondary">@color/tp07_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp07_vert_clair</item>
        <item name="actionBarStyle">@style/tp07_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp07_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp07_BoutonAlAmal</item>
    </style>

    <style name="tp07_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp07_bleu_nuit</item>
    </style>

    <style name="tp07_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp07_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp07_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp07_TitreBarre</item>
    </style>

    <style name="tp07_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp07_white</item>
    </style>

    <style name="tp07_Theme.TPS07" parent="tp07_Base.Theme.TPS07" />
</resources>
