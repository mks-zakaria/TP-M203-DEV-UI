<resources>
    <!-- Thème clair avec barre d'action : le titre de l'étape s'affiche en haut -->
    <style name="tp18_Base.Theme.TPS18" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/tp18_vert_ofppt</item>
        <item name="colorOnPrimary">@color/tp18_white</item>
        <item name="colorSecondary">@color/tp18_vert_ofppt</item>
        <item name="colorSecondaryContainer">@color/tp18_vert_clair</item>
        <item name="actionBarStyle">@style/tp18_BarreAlAmal</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Textes et boutons lisibles par défaut (20sp / 18sp) -->
        <item name="android:textViewStyle">@style/tp18_TexteAlAmal</item>
        <item name="materialButtonStyle">@style/tp18_BoutonAlAmal</item>
    </style>

    <style name="tp18_TexteAlAmal" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tp18_bleu_nuit</item>
    </style>

    <style name="tp18_BoutonAlAmal" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="tp18_BarreAlAmal" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/tp18_vert_ofppt</item>
        <item name="titleTextStyle">@style/tp18_TitreBarre</item>
    </style>

    <style name="tp18_TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tp18_white</item>
    </style>

    <style name="tp18_Theme.TPS18" parent="tp18_Base.Theme.TPS18" />

    <!-- Variante sans barre d'action (écrans avec Toolbar) -->
    <style name="tp18_Theme.TPS18.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
