<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Étape 1 — options (CheckBox) : chaque case se coche à part -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Options (2 DH chacune)"
        android:textSize="24sp"
        android:textStyle="bold" />
    <CheckBox
        android:id="@+id/chkImpression"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Impression"
        android:textSize="22sp" />
    <CheckBox
        android:id="@+id/chkCasque"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casque audio"
        android:textSize="22sp" />
    <CheckBox
        android:id="@+id/chkScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scanner"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculer" />
    <TextView
        android:id="@+id/txtTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp" />

</LinearLayout>