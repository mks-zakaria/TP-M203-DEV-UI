        <!--
        ╔══════════════════════════════════════════════════════════════════════════╗
        ║  CHOISIR LE MODE : l'application démarre sur l'activité qui contient      ║
        ║  le bloc <intent-filter> MAIN / LAUNCHER.                                 ║
        ║    MODE COURS → bloc dans PlaygroundActivity                              ║
        ║    MODE TP    → bloc dans TpActivity                                      ║
        ║  Pour changer : COUPER le bloc (Ctrl+X) et le COLLER (Ctrl+V) dans        ║
        ║  l'autre activité, puis ▶ Run. Un seul bloc LAUNCHER dans tout le fichier. ║
        ╚══════════════════════════════════════════════════════════════════════════╝
        -->

        <!-- MODE COURS : Playground, écran vide pour tester les exemples du cours -->
        <activity
            android:name=".PlaygroundActivity"
            android:exported="true"
            android:label="@string/label_cours">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MODE TP : menu des travaux pratiques -->
        <activity
            android:name=".TpActivity"
            android:exported="true"
            android:label="@string/label_tp">
            <!-- (le bloc intent-filter MAIN / LAUNCHER se colle ici) -->
        </activity>


